# Folder of Markdown notes (relative to backend/ or absolute). This is the source of truth.
NOTES_DIR=../notes

# OpenRouter — required for AI review. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Embedding / late-interaction search
EMBEDDINGS_ENABLED=true
COLBERT_MODEL=lightonai/Agent-ModernColBERT
# How often (seconds) the background task re-encodes changed notes to keep the index warm
REINDEX_INTERVAL_S=5

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
