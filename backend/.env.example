# Copy to backend/.env (gitignored) — never commit real keys. Read from backend/.env
# whatever directory the backend starts in; real environment variables win over this
# file. Relative paths below are relative to backend/.

# Folder for the notes database, its Markdown mirrors, pictures, backups and the search
# index (relative to backend/ or absolute). The SQLite database is the source of truth.
NOTES_DIR=../notes

# OpenRouter — needed for Ask (everything else works without it).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model for "Ask your notes" — must answer fast to stay under ~3 s (measured: Mercury 3
# p50 0.9 s; Gemini 2.5 Flash Lite 1.0 s). Reasoning models need ASK_REASONING_EFFORT=none.
ASK_MODEL=inception/mercury-3
ASK_REASONING_EFFORT=none
# Fallback for LLM calls that name no model (Ask always uses ASK_MODEL).
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Embedding / late-interaction search (ColBERT). Off: search and related notes use
# keyword matching only.
EMBEDDINGS_ENABLED=true
COLBERT_MODEL=lightonai/Agent-ModernColBERT
# auto = bfloat16 on CPUs with native support (several times faster), else float32
EMBEDDINGS_PRECISION=auto
# How often (seconds) the background indexer re-encodes changed paragraphs
REINDEX_INTERVAL_S=5
# Threads one model pass may use. 0 = half the cores, at most 4 (more oversubscribes
# the cores searches and OCR need: 4 of 4 cores beside other work = 1 s query p90).
EMBEDDINGS_THREADS=0

# The backend's own background OCR of pictures and PDFs (local RapidOCR PP-OCRv6,
# cached by content hash) so their text is searchable. The Mac app's Apple Vision
# reader is a separate setting in the app. OCR_THREADS=0: half the cores, at most 4.
VISION_ENABLED=true
OCR_THREADS=0

# Keep a daily SQLite snapshot in NOTES_DIR/.fortress-backups (last 7 kept)
AUTO_BACKUP_ENABLED=true

# The OneNote converter (tools/fortress-onenote). Empty: the repository build, next to
# the running Python, an app bundle's Resources/bin, or PATH. A run is stopped after
# FORTRESS_ONENOTE_TIMEOUT_S seconds.
FORTRESS_ONENOTE_BIN=
FORTRESS_ONENOTE_TIMEOUT_S=3600

# Not read from this file: FORTRESS_TOKEN and FORTRESS_PARENT_PID (set by the Mac app
# when it starts the backend) and FORTRESS_ALLOWED_HOSTS come from the environment only.
