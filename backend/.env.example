# Folder of Markdown notes (relative to backend/ or absolute). This is the source of truth.
NOTES_DIR=../notes

# OpenRouter — required for AI review. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Embedding / late-interaction search
EMBEDDINGS_ENABLED=true
COLBERT_MODEL=lightonai/Agent-ModernColBERT
# How often (seconds) the background task re-encodes changed notes to keep the index warm
REINDEX_INTERVAL_S=5

# Image understanding so pasted images are searchable.
# VISION_ENABLED runs OCR (fast, ~1s/image) and is on by default.
# Local captions run in the background; repeated image bytes reuse cached results.
VISION_ENABLED=true
VLM_CAPTION_ENABLED=true
VLM_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct

# Keep a daily SQLite snapshot in NOTES_DIR/.fortress-backups (last 7 kept)
AUTO_BACKUP_ENABLED=true

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
